{
  "name": "pragnesh-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "build": "node scripts/gen-sitemap.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"scripts/*.mjs\" \"tests/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"scripts/*.mjs\" \"tests/**/*.{js,mjs}\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.8.1",
    "vite": "^6.2.0"
  }
}
